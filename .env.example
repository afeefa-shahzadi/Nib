# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_SECRET_KEY=your-supabase-secret-key
# Seed/maintenance scripts read SUPABASE_SERVICE_ROLE_KEY — it must equal
# SUPABASE_SECRET_KEY (same underlying key, two names).
SUPABASE_SERVICE_ROLE_KEY=your-supabase-secret-key
SUPABASE_ACCESS_TOKEN=your-supabase-access-token

# Razorpay Payments Configuration
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# RazorpayX payout automation — leave unset to keep payouts manual (admin settles
# each one by hand). Set all four to enable approve-and-disburse. PII encryption
# of payout methods also needs BYOK_ENCRYPTION_KEY (below). See docs/payouts-go-live.md.
RAZORPAYX_KEY_ID=
RAZORPAYX_KEY_SECRET=
RAZORPAYX_ACCOUNT_NUMBER=
RAZORPAYX_WEBHOOK_SECRET=

# Cron auth — routes fail closed (500) when unset. Vercel sends it as Bearer token.
CRON_SECRET=

# Email (SMTP) — leave SMTP_HOST unset to use Ethereal test mail in dev
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Set true for implicit TLS on port 465 (default: STARTTLS on 587)
SMTP_SECURE=false
# Sender identity used by lib/email/mailer.ts (EMAIL_FROM is used by lib/email.ts)
SMTP_FROM=
# Defaults to CONTACT_EMAIL
EMAIL_FROM=

# Ops alerting — Slack-compatible incoming webhook; money-path failures POST here
ALERT_WEBHOOK_URL=

# BYOK secret encryption at rest — 32 bytes hex (64 chars).
# Generate: openssl rand -hex 32. Required in production; unset stores plaintext (dev only).
BYOK_ENCRYPTION_KEY=

# AI Gateway Integration Configuration
MISTRAL_API_KEY=your-mistral-api-key

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Root domain for subdomain/custom-domain routing (proxy.ts)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Signs unsubscribe/confirm email tokens. Generate: openssl rand -hex 32
EMAIL_TOKEN_SECRET=

# Free launch: unset = ON. Only the exact value 0 turns it off.
# LAUNCH_FREE=0

# Code execution (Run buttons). Leave unset to hide them.
PISTON_API_URL=
PISTON_AUTH_TOKEN=

# Contact, legal and sender address (lib/brand.ts default shown)
CONTACT_EMAIL=writeson.nib@gmail.com

# Footer social links: an icon shows only when its URL is set
NEXT_PUBLIC_SOCIAL_X=
NEXT_PUBLIC_SOCIAL_GITHUB=
NEXT_PUBLIC_SOCIAL_LINKEDIN=
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_YOUTUBE=

# Account that owns the official blog; used by `pnpm seed:blog`
OFFICIAL_ACCOUNT_EMAIL=
